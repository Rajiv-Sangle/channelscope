        <ClinVarAccession Accession="SCV001653561" DateUpdated="2025-09-27" DateCreated="2021-06-08" Type="SCV" Version="3" SubmitterName="ClinGen Malignant Hyperthermia Susceptibility Variant Curation Expert Panel, ClinGen" OrgID="508072" OrganizationCategory="consortium"/>
