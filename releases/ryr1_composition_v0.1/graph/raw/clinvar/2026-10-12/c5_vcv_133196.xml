        <ClinVarSubmissionID localKey="2427fc83-d30a-408a-a16e-bb7a164eaf98" localKeyIsSubmitted="1" submittedAssembly="GRCh37"/>
        <ClinVarAccession Accession="SCV002047610" DateUpdated="2025-12-20" DateCreated="2022-01-08" Type="SCV" Version="4" SubmitterName="ClinGen Malignant Hyperthermia Susceptibility Variant Curation Expert Panel, ClinGen" OrgID="508072" OrganizationCategory="consortium"/>
